{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "dist-electron",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "electron/**/*.ts",
        "electron/**/*.cts",
        "shared/**/*.ts"
    ]
}